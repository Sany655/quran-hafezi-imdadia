{"id": 114, "name_ar": "الناس", "name_bn": "আন-নাস", "name_en": "An-Nas", "meaning_bn": "মানুষ জাতি", "revelation_type": "মাক্কী", "total_ayahs": 6, "start_page": 611, "ayahs": [{"a": 1, "p": 611, "ar": "قُلۡ اَعُوۡذُ بِرَبِّ النَّاسِۙ‏", "bn_t": "বল, ‘আমি আশ্রয় চাচ্ছি মানুষের প্রতিপালকের,", "bn_z": "বলুন, ‘আমি আশ্ৰয় প্রার্থনা করছি মানুষের রবের,"}, {"a": 2, "p": 611, "ar": "مَلِكِ النَّاسِۙ‏", "bn_t": "মানুষের অধিপতির,", "bn_z": "মানুষের অধিপতির,"}, {"a": 3, "p": 611, "ar": "اِلٰهِ النَّاسِۙ‏", "bn_t": "মানুষের প্রকৃত ইলাহর,", "bn_z": "মানুষের ইলাহের কাছে [১]"}, {"a": 4, "p": 611, "ar": "مِنۡ شَرِّ الۡوَسۡوَاسِ  ۙ الۡخَـنَّاسِ ۙ‏", "bn_t": "যে নিজেকে লুকিয়ে রেখে বার বার এসে কুমন্ত্রণা দেয় তার অনিষ্ট হতে,", "bn_z": "আত্মগোপনকারী কুমন্ত্রণাদাতার [১] অনিষ্ট হতে,"}, {"a": 5, "p": 611, "ar": "الَّذِىۡ يُوَسۡوِسُ فِىۡ صُدُوۡرِ النَّاسِۙ‏", "bn_t": "যে কুমন্ত্রণা দেয় মানুষের অন্তরে", "bn_z": "যে কুমন্ত্রণা দেয় মানুষের অন্তরে,"}, {"a": 6, "p": 611, "ar": "مِنَ الۡجِنَّةِ وَالنَّاسِ‏", "bn_t": "(এই কুমন্ত্রণাদাতা হচ্ছে) জিন্নের মধ্য হতে এবং মানুষের মধ্য হতে।", "bn_z": "জিনের মধ্য থেকে এবং মানুষের মধ্য থেকে [১]।’"}]}